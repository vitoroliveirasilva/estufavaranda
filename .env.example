APP_NAME=Estufa da varanda
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

API_BASE_URL=http://localhost
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

APP_SECRET_KEY=app-secret-key
ACCESS_TOKEN_SECRET=access-token-secret
REFRESH_TOKEN_SECRET=refresh-token-secret

ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
PASSWORD_RESET_EXPIRES_MINUTES=30

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/estufa_da_varanda

UPLOAD_BASE_PATH=/data/uploads
MAX_UPLOAD_MB=8
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

DEFAULT_TIMEZONE=America/Sao_Paulo
ENABLE_ADMIN_READ_ALL_PLANTS=true

RATE_LIMIT_DEFAULT=200/hour
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=10
LOGIN_BLOCK_MINUTES=15

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

CLIMATE_PROVIDER=open_meteo
CLIMATE_API_KEY=
CLIMATE_REQUEST_TIMEOUT_SECONDS=10

AI_PROVIDER_MODE=rules
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
AI_PROVIDER_MODEL=

PUSH_PROVIDER_MODE=log
PUSH_PROVIDER_KEY=

LOG_LEVEL=INFO
LOG_JSON=true
SECURE_COOKIES=false

POSTGRES_DB=estufa_da_varanda
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

NGINX_SERVER_NAME=localhost
TZ=America/Sao_Paulo
